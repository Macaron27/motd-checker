# Database (BungeeServerManager)
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# Web server (optional)
ENABLE_WEB=1
PORT=3000

# Timings in ms (optional)
REFRESH_INTERVAL=15000
MINECRAFT_TIMEOUT=10000

# Discord notifications (optional, enable with --discord)
DISCORD_BOT_TOKEN=your_bot_token
DISCORD_GUILD_ID=your_guild_id
DISCORD_CHANNEL_ID=your_channel_id

# Slack / generic JSON webhook notifications (optional, enabled when set)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# WEBHOOK_URL=https://example.com/motd-hook
